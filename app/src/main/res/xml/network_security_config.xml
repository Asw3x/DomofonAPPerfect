<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Видеопотоки домофонных камер могут отдаваться по HTTP, но сам API всегда идёт строго по HTTPS -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.domonap.ru</domain>
    </domain-config>
</network-security-config>
